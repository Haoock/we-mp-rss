{
  "source_db": "../../data/we_mp_rss.db",
  "state_dir": "~/.local/state/werss-ai-digest",
  "timezone": "Asia/Shanghai",
  "env_file": ".env",
  "prepare_limit": 5,
  "summary_max_attempts": 3,
  "send_max_attempts": 5,
  "retry_seconds": 120,
  "schedule_grace_seconds": 300,
  "max_articles_per_push": 20,
  "message_max_bytes": 12000,
  "model": {
    "provider": "anthropic",
    "name": "MiniMax-M3.1-Flash",
    "effort": "low",
    "timeout_seconds": 180,
    "max_input_chars": 60000,
    "max_output_tokens": 4096,
    "claude_command": "claude",
    "claude_safe_mode": true,
    "api_url": "https://api.minimax.cn/anthropic/v1/messages",
    "api_key_env": "MINIMAX_API_KEY",
    "api_version": "2023-06-01"
  },
  "groups": [
    {
      "task_id": "替换为科技新闻更新的任务ID",
      "push_minutes": [30],
      "webhook_env": "FEISHU_WEBHOOK",
      "sign_secret_env": ""
    },
    {
      "task_id": "替换为AI更新的任务ID",
      "push_minutes": [33],
      "webhook_env": "FEISHU_WEBHOOK",
      "sign_secret_env": ""
    },
    {
      "task_id": "替换为股市更新的任务ID",
      "push_minutes": [36],
      "webhook_env": "FEISHU_WEBHOOK",
      "sign_secret_env": ""
    }
  ]
}
